{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ReadRawEcommerceData",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject"
            ],
            "Resource": "arn:aws:s3:::ahmed-data-bucket-2026-new/raw/ecommerce/*"
        },
        {
            "Sid": "ListEcommerceBucket",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket"
            ],
            "Resource": "arn:aws:s3:::ahmed-data-bucket-2026-new"
        },
        {
            "Sid": "ReadProcessedEcommerceData",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject"
            ],
            "Resource": "arn:aws:s3:::ahmed-data-bucket-2026-new/processed/ecommerce/*"
        },
        {
            "Sid": "WriteProcessedEcommerceData",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:AbortMultipartUpload"
            ],
            "Resource": "arn:aws:s3:::ahmed-data-bucket-2026-new/processed/ecommerce/*"
        }
    ]
}
